# Copia este archivo como .env.local (NO se sube al repo) y pega los valores de
# Supabase → Project Settings → API. Usa solo la clave pública "anon", nunca la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=pega-aqui-la-anon-key
# Clave gratis de https://api.nasa.gov (1000 consultas/hora). Si falta, la app usa DEMO_KEY (30/hora por IP).
VITE_NASA_API_KEY=pega-aqui-tu-clave-nasa
